  mix: {
    desc: "Générer une playlist par IA et la créer dans ta bibliothèque cloud",
    usage: 'am mix "<description>" [--limit N] [--name <nom>] [--dry-run]',
    run: async (args) => {
      const dryRun = args.includes("--dry-run");
      args = args.filter((a) => a !== "--dry-run");
      let name: string | undefined;
      const ni = args.indexOf("--name");
      if (ni !== -1) {
        name = args[ni + 1];
        args = [...args.slice(0, ni), ...args.slice(ni + 2)];
      }
      const { query: description, limit } = parseQuery(args);
      if (!description) die('Usage : am mix "<description>" [--limit N] [--name <nom>] [--dry-run]');

      // Le token utilisateur est requis pour committer — on échoue avant de payer un appel LLM.
      if (!dryRun && !loadConfig().mediaUserToken) {
        die("am mix a besoin de ton Media User Token pour créer la playlist — lance `am login` pour la marche à suivre, ou utilise --dry-run.");
      }

      const sf = await getStorefront();
      console.log(dim(`Génération de la playlist (${limit} morceaux)…`));
      const plan = await generateMixPlan(description, limit, sf);

      console.log(dim("Résolution contre le catalogue Apple Music…"));
      const resolved: Awaited<ReturnType<typeof resolveMixTrack>>[] = [];
      const CHUNK = 8;
      for (let i = 0; i < plan.tracks.length; i += CHUNK) {
        resolved.push(...(await Promise.all(plan.tracks.slice(i, i + CHUNK).map(resolveMixTrack))));
      }

      const found = resolved.filter((r) => r.song);
      const missed = resolved.filter((r) => !r.song);
      const playlistName = name ?? plan.name;

      console.log(`\n${bold(playlistName)} — ${dim(plan.description)}`);
      for (const r of resolved) {
        if (r.song) {
          const a = r.song.attributes;
          console.log(`  ${green("✓")} ${bold(a.name)} — ${a.artistName}${r.exact ? "" : dim("  (correspondance approximative)")}`);
        } else {
          console.log(`  ${red("✗")} ${r.track.title} — ${r.track.artist} ${dim("(introuvable au catalogue)")}`);
        }
      }
      if (found.length === 0) die("Aucun morceau résolu — playlist non créée.");

      if (dryRun) {
        console.log(dim(`\n--dry-run : rien n'a été créé (${found.length}/${resolved.length} morceaux résolus).`));
        return;
      }

      const seen = new Set<string>();
      const ids = found.map((r) => r.song!.id).filter((id) => !seen.has(id) && (seen.add(id), true));
      await createCloudPlaylist(playlistName, plan.description, ids);
      console.log(`\n${green("✓")} Playlist ${bold(playlistName)} créée avec ${ids.length} morceaux dans ta bibliothèque cloud`);
      console.log(dim("  (la synchro dans Music.app peut prendre quelques secondes)"));
    },
  },

