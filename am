  spotify: {
    desc: "Exporter une playlist vers Spotify (lien partageable)",
    usage: "am spotify <playlist> [--name <nom>] [--private] [--dry-run]",
    run: async (args) => {
      const dryRun = args.includes("--dry-run");
      args = args.filter((a) => a !== "--dry-run");
      const isPrivate = args.includes("--private");
      args = args.filter((a) => a !== "--private");
      let overrideName: string | undefined;
      const ni = args.indexOf("--name");
      if (ni !== -1) { overrideName = args[ni + 1]; args = [...args.slice(0, ni), ...args.slice(ni + 2)]; }
      const playlistName = args.join(" ");
      if (!playlistName) die("Usage : am spotify <playlist> [--name <nom>] [--private] [--dry-run]");

      if (!loadConfig().spotify?.refreshToken) {
        die("Compte Spotify non connecté — lance `am spotify-login` pour la marche à suivre.");
      }

      const tracks = jxa<{ name: string; artist: string }[]>(`
        ${PLAYLIST_HELPERS}
        const pl = playlistByName(arg);
        try {
          const names = pl.tracks.name();
          const artists = pl.tracks.artist();
          return names.map((n, i) => ({ name: n, artist: artists[i] }));
        } catch { return []; }
      `, playlistName);

      if (tracks.length === 0) die("Playlist vide : rien à exporter.");

      console.log(dim(`Recherche de ${tracks.length} morceau${tracks.length > 1 ? "x" : ""} sur Spotify…`));
      const results: (SpotifyMatch | null)[] = [];
      const CHUNK = 8;
      for (let i = 0; i < tracks.length; i += CHUNK) {
        results.push(...(await Promise.all(tracks.slice(i, i + CHUNK).map(spotifySearchTrack))));
      }

      const finalName = overrideName ?? playlistName;
      console.log(`\n${bold(finalName)}`);
      for (let i = 0; i < tracks.length; i++) {
        const t = tracks[i];
        const r = results[i];
        if (r) {
          console.log(`  ${green("✓")} ${bold(r.name)} — ${r.artist}${r.exact ? "" : dim("  (correspondance approximative)")}`);
        } else {
          console.log(`  ${red("✗")} ${t.name} — ${t.artist} ${dim("(introuvable sur Spotify)")}`);
        }
      }

      const found = results.filter(Boolean) as SpotifyMatch[];
      if (found.length === 0) die("Aucun morceau trouvé sur Spotify — playlist non créée.");

      if (dryRun) {
        console.log(dim(`\n--dry-run : rien n'a été créé (${found.length}/${tracks.length} morceaux trouvés).`));
        return;
      }

      const playlist = await spotifyApi("/v1/me/playlists", {
        method: "POST",
        body: { name: finalName, public: !isPrivate, description: "Exportée d'Apple Music avec am" },
      });

      const seen = new Set<string>();
      const uris = found.map((r) => r.uri).filter((uri) => !seen.has(uri) && (seen.add(uri), true));
      for (let i = 0; i < uris.length; i += 100) {
        await spotifyApi(`/v1/playlists/${playlist.id}/items`, { method: "POST", body: { uris: uris.slice(i, i + 100) } });
      }

      const missed = tracks.length - found.length;
      console.log(`\n${green("✓")} Playlist ${bold(finalName)} créée sur Spotify (${found.length}/${tracks.length} morceaux)`);
      console.log(bold(playlist.external_urls.spotify));
      if (missed > 0) console.log(dim(`${missed} morceau${missed > 1 ? "x" : ""} introuvable${missed > 1 ? "s" : ""} — voir ✗ ci-dessus.`));
    },
  },

  "spotify-library": {
    desc: "Migrer toute la bibliothèque vers Spotify (titres likés + playlists)",
    usage: "am spotify-library [--liked-only|--playlists-only] [--public] [--dry-run]",
    run: async (args) => {
      const dryRun = args.includes("--dry-run");
      const doLiked = !args.includes("--playlists-only");
      const doPlaylists = !args.includes("--liked-only");
      const isPublic = args.includes("--public");
      if (!loadConfig().spotify?.refreshToken) {
        die("Compte Spotify non connecté — lance `am spotify-login` pour la marche à suivre.");
      }

      console.log(dim("Lecture de la bibliothèque Apple Music…"));
      const library = jxa<{ id: string; name: string; artist: string; album: string }[]>(`
        const lib = Music.libraryPlaylists[0];
        const ids = lib.tracks.persistentID(), names = lib.tracks.name(), artists = lib.tracks.artist(),
              albums = lib.tracks.album(), added = lib.tracks.dateAdded();
        return ids.map((id, i) => ({ id, name: names[i], artist: artists[i], album: albums[i], added: added[i] }))
          .sort((a, b) => a.added - b.added);
      `);
      type LibTrack = (typeof library)[number];
      const playlists = jxa<{ name: string; tracks: LibTrack[] }[]>(`
        const tracksOf = (pl) => {
          try {
            const ids = pl.tracks.persistentID(), names = pl.tracks.name(), artists = pl.tracks.artist(), albums = pl.tracks.album();
            return ids.map((id, i) => ({ id, name: names[i], artist: artists[i], album: albums[i] }));
          } catch { return []; }
        };
        return Music.playlists()
          .filter(p => { try { return p.specialKind() === "none"; } catch { return true; } })
          .filter(p => !["Library", "Music"].includes(p.name()))
          .map(p => ({ name: p.name(), tracks: tracksOf(p) }));
      `);
      const byId = new Map([...library, ...playlists.flatMap((p) => p.tracks)].map((t) => [t.id, t]));
      const wantedIds = new Set([
        ...(doLiked ? library : []).map((t) => t.id),
        ...(doPlaylists ? playlists.flatMap((p) => p.tracks) : []).map((t) => t.id),
      ]);
      const needed = [...wantedIds].map((id) => byId.get(id)!);

      const matches = loadMatches();
      const todo = needed.filter((t) => !(t.id in matches));
      console.log(dim(`${needed.length} morceaux, ${todo.length} à chercher sur Spotify (les autres sont déjà appariés)…`));
      const CHUNK = 4;
      for (let i = 0; i < todo.length; i += CHUNK) {
        const batch = todo.slice(i, i + CHUNK);
        const found = await Promise.all(batch.map(spotifySearchTrack));
        batch.forEach((t, j) => { matches[t.id] = found[j]?.uri ?? null; });
        const done = Math.min(i + CHUNK, todo.length);
        if (done % 100 < CHUNK || done === todo.length) { saveMatches(matches); process.stdout.write(`\r  ${done}/${todo.length}`); }
      }
      if (todo.length) console.log();

      const unmatched = needed.filter((t) => matches[t.id] === null);
      writeFileSync(UNMATCHED_PATH, unmatched.map((t) => `${t.name} — ${t.artist} — ${t.album}`).join("\n") + "\n");
      console.log(`${green("✓")} ${needed.length - unmatched.length}/${needed.length} morceaux trouvés sur Spotify` +
        (unmatched.length ? dim(` — ${unmatched.length} introuvables listés dans ${UNMATCHED_PATH}`) : ""));
      if (dryRun) { console.log(dim("--dry-run : rien n'a été écrit sur Spotify.")); return; }

      if (doLiked) {
        const uris = [...new Set(library.map((t) => matches[t.id]).filter(Boolean))] as string[];
        for (let i = 0; i < uris.length; i += 40) {
          await spotifyApi(`/v1/me/library?uris=${encodeURIComponent(uris.slice(i, i + 40).join(","))}`, { method: "PUT" });
          process.stdout.write(`\r  Titres likés : ${Math.min(i + 40, uris.length)}/${uris.length}`);
        }
        console.log(`\r${green("✓")} ${uris.length} titres likés sur Spotify (du plus ancien au plus récent)`);
      }

      if (doPlaylists) {
        const existing = new Set<string>();
        for (let offset = 0; ; offset += 50) {
          const page = await spotifyApi(`/v1/me/playlists?limit=50&offset=${offset}`);
          for (const p of page.items ?? []) existing.add(p.name);
          if (!page.next) break;
        }
        for (const pl of playlists) {
          const uris = [...new Set(pl.tracks.map((t) => matches[t.id]).filter(Boolean))] as string[];
          if (uris.length === 0) { console.log(`  ${dim("–")} ${pl.name} ${dim("(vide ou introuvable, ignorée)")}`); continue; }
          if (existing.has(pl.name)) { console.log(`  ${dim("=")} ${pl.name} ${dim("(déjà sur Spotify, ignorée)")}`); continue; }
          const created = await spotifyApi("/v1/me/playlists", {
            method: "POST",
            body: { name: pl.name, public: isPublic, description: "Importée d'Apple Music avec am" },
          });
          for (let i = 0; i < uris.length; i += 100) {
            await spotifyApi(`/v1/playlists/${created.id}/items`, { method: "POST", body: { uris: uris.slice(i, i + 100) } });
          }
          console.log(`  ${green("✓")} ${pl.name} ${dim(`(${uris.length}/${pl.tracks.length})`)}`);
        }
      }
    },
  },

