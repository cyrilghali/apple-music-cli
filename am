    run: async (args) => {
      const dryRun = args.includes("--dry-run");
      args = args.filter((a) => a !== "--dry-run");
      let name: string | undefined;
      const ni = args.indexOf("--name");
      if (ni !== -1) {
        name = args[ni + 1];
        args = [...args.slice(0, ni), ...args.slice(ni + 2)];
      }
      const { query: description, limit } = parseQuery(args);
      if (!description) die('Usage : am mix "<description>" [--limit N] [--name <nom>] [--dry-run]');

      // Le token utilisateur est requis pour committer — on échoue avant de payer un appel LLM.
      if (!dryRun && !loadConfig().mediaUserToken) {
        die("am mix a besoin de ton Media User Token pour créer la playlist — lance `am login` pour la marche à suivre, ou utilise --dry-run.");
      }

      const sf = await getStorefront();
      console.log(dim(`Génération de la playlist (${limit} morceaux)…`));
      const plan = await generateMixPlan(description, limit, sf);

      console.log(dim("Résolution contre le catalogue Apple Music…"));
      const resolved: Awaited<ReturnType<typeof resolveMixTrack>>[] = [];
      const CHUNK = 8;
      for (let i = 0; i < plan.tracks.length; i += CHUNK) {
        resolved.push(...(await Promise.all(plan.tracks.slice(i, i + CHUNK).map(resolveMixTrack))));
      }

      const found = resolved.filter((r) => r.song);
      const missed = resolved.filter((r) => !r.song);
      const playlistName = name ?? plan.name;

      console.log(`\n${bold(playlistName)} — ${dim(plan.description)}`);
      for (const r of resolved) {
        if (r.song) {
          const a = r.song.attributes;
          console.log(`  ${green("✓")} ${bold(a.name)} — ${a.artistName}${r.exact ? "" : dim("  (correspondance approximative)")}`);
        } else {
          console.log(`  ${red("✗")} ${r.track.title} — ${r.track.artist} ${dim("(introuvable au catalogue)")}`);
        }
      }
      if (found.length === 0) die("Aucun morceau résolu — playlist non créée.");

      if (dryRun) {
        console.log(dim(`\n--dry-run : rien n'a été créé (${found.length}/${resolved.length} morceaux résolus).`));
        return;
      }

      const seen = new Set<string>();
      const ids = found.map((r) => r.song!.id).filter((id) => !seen.has(id) && (seen.add(id), true));
      await createCloudPlaylist(playlistName, plan.description, ids);
      console.log(`\n${green("✓")} Playlist ${bold(playlistName)} créée avec ${ids.length} morceaux dans ta bibliothèque cloud`);
      console.log(dim("  (la synchro dans Music.app peut prendre quelques secondes)"));
    },
  },

  login: {
    desc: "Enregistrer ton Media User Token (écritures cloud)",
    usage: "am login <media-user-token>",
    run: async (args) => {
      const token = args[0];
      if (!token) {
        const cfg = loadConfig();
        console.log(`Token dev      : ${cfg.devToken ? green("ok (auto)") : dim("absent (récupéré automatiquement)")}`);
        console.log(`Media User Token : ${cfg.mediaUserToken ? green("enregistré") : red("absent")}`);
        if (!cfg.mediaUserToken) {
          console.log(
            "\nPour l'obtenir :\n" +
            "  1. Ouvre https://music.apple.com et connecte-toi\n" +
            "  2. Outils de développement (⌥⌘I) → Application/Stockage → Cookies → music.apple.com\n" +
            `  3. Copie la valeur du cookie ${bold("media-user-token")}\n` +
            "  4. Lance : am login '<token>'"
          );
        }
        return;
      }
      saveConfig({ ...loadConfig(), mediaUserToken: token, storefront: undefined });
      const sf = await getStorefront();
      console.log(`${green("✓")} Token enregistré (storefront : ${bold(sf)})`);
    },
  },

  delete: {
    desc: "Supprimer un morceau de la bibliothèque (synchronisé au cloud)",
    usage: "am delete <termes>",
    run: (args) => {
      const query = args.join(" ");
      if (!query) die("Usage : am delete <termes>");
      const matches = jxa<Track[]>(`
        ${TRACK_PROPS}
        const lib = Music.libraryPlaylists[0];
        return Music.search(lib, { for: arg }).slice(0, 10).map(trackInfo);
      `, query);
      if (matches.length === 0) die(`Aucun morceau trouvé pour : ${query}`);
      if (matches.length > 1) {
        console.log(`${matches.length} morceaux correspondent — précise ta recherche :`);
        printTracks(matches);
        return;
      }
      const t = matches[0];
      const deleted = jxa<Track>(`
        ${TRACK_PROPS}
        const lib = Music.libraryPlaylists[0];
        const track = lib.tracks.whose({ persistentID: arg })[0];
        if (!track.exists()) throw "Morceau introuvable (id " + arg + ")";
        const info = trackInfo(track);
        Music.delete(track);
        return info;
      `, t.id);
      console.log(`${red("✗")} ${bold(deleted.name)} — ${deleted.artist} supprimé de la bibliothèque`);
      console.log(dim("  (avec « Synchroniser la bibliothèque » activé, la suppression se propage au cloud)"));
    },
  },

  remove: {
    desc: "Retirer un morceau d'une playlist (sans le supprimer de la bibliothèque)",
    usage: "am remove <termes> --from <playlist>",
    run: (args) => {
      const fromIdx = args.indexOf("--from");
      if (fromIdx === -1 || fromIdx === args.length - 1) die("Usage : am remove <termes> --from <playlist>");
      const query = args.slice(0, fromIdx).join(" ").toLowerCase();
      const playlist = args.slice(fromIdx + 1).join(" ");
      if (!query) die("Usage : am remove <termes> --from <playlist>");
      const removed = jxa<Track>(`
        ${TRACK_PROPS}${PLAYLIST_HELPERS}
        const pl = playlistByName(arg.playlist);
        const tracks = safeTracks(pl);
        const match = tracks.find(t =>
          (t.name() + " " + t.artist()).toLowerCase().includes(arg.query));
        if (!match) throw "Aucun morceau de la playlist ne correspond à : " + arg.query;
        const info = trackInfo(match);
        Music.delete(match);
        return info;
      `, { query, playlist });
      console.log(`${green("✓")} ${bold(removed.name)} — ${removed.artist} retiré de ${bold(playlist)}`);
    },
  },

  help: {
    desc: "Afficher cette aide",
    run: () => {
      console.log(`${bold("am")} — Apple Music en ligne de commande\n`);
      for (const [name, c] of Object.entries(commands)) {
        console.log(`  ${bold(name.padEnd(14))} ${c.desc}${c.usage ? dim(`  (${c.usage})`) : ""}`);
      }
    },
  },
};

function parseQuery(args: string[]): { query: string; limit: number } {
  let limit = 20;
  const li = args.indexOf("--limit");
  if (li !== -1) {
    limit = Number(args[li + 1]) || 20;
    args = [...args.slice(0, li), ...args.slice(li + 2)];
  }
  return { query: args.join(" "), limit };
}

// ---------- main ----------

const [cmd = "now", ...rest] = process.argv.slice(2);
const command = commands[cmd];
if (!command) {
  console.error(`Commande inconnue : ${cmd}\n`);
  commands.help.run([]);
  process.exit(1);
}
try {
  await command.run(rest);
} catch (e) {
  die(e instanceof Error ? e.message : String(e));
}
