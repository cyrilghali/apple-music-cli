// ---------- Génération de playlist par IA (POC) ----------

interface MixTrack { title: string; artist: string }
interface MixPlan { name: string; description: string; tracks: MixTrack[] }

const MIX_SCHEMA = {
  type: "object",
  properties: {
    name: { type: "string", description: "Nom court de la playlist" },
    description: { type: "string", description: "Description en une phrase" },
    tracks: {
      type: "array",
      items: {
        type: "object",
        properties: {
          title: { type: "string", description: "Titre exact du morceau" },
          artist: { type: "string", description: "Artiste principal" },
        },
        required: ["title", "artist"],
        additionalProperties: false,
      },
    },
  },
  required: ["name", "description", "tracks"],
  additionalProperties: false,
};

async function generateMixPlan(description: string, count: number, storefront: string): Promise<MixPlan> {
  // Import dynamique : Bun auto-installe @anthropic-ai/sdk au premier usage,
  // le reste du CLI ne déclenche jamais l'installation.
  let Anthropic: any;
  try {
    Anthropic = (await import("@anthropic-ai/sdk")).default;
  } catch (e) {
    die(`Impossible de charger @anthropic-ai/sdk (réseau requis au premier lancement) : ${e}`);
  }
  let res: any;
  try {
    const client = new Anthropic();
    res = await client.messages.create({
      model: "claude-opus-4-8",
      max_tokens: 16000,
      thinking: { type: "adaptive" },
      output_config: { format: { type: "json_schema", schema: MIX_SCHEMA } },
      messages: [
        {
          role: "user",
          content:
            `Tu génères une playlist Apple Music à partir de cette demande : « ${description} ».\n` +
            `Storefront de l'utilisateur : ${storefront}.\n` +
            `Propose exactement ${count} morceaux RÉELS disponibles en streaming sur Apple Music — ` +
            `pas de titres inventés, pas de doublons, un seul morceau par artiste sauf si la demande impose le contraire. ` +
            `Respecte l'intention de la demande (ambiance, époque, langue, énergie) et l'ordre d'écoute ` +
            `(si une progression est demandée, ordonne les morceaux en conséquence). ` +
            `Donne un nom de playlist court et une description d'une phrase, dans la langue de la demande.`,
        },
      ],
    });
  } catch (e) {
    const msg = e instanceof Error ? e.message : String(e);
    if (/resolve authentication|api.?key|authentication_error/i.test(msg)) {
      die(
        "Clé API Anthropic introuvable ou invalide.\n" +
        "  export ANTHROPIC_API_KEY='sk-ant-...'   (console.anthropic.com → API Keys)"
      );
    }
    die(`Appel Claude échoué : ${msg}`);
  }
  if (res.stop_reason === "refusal") die("Génération refusée par le modèle — reformule ta demande.");
  const text = res.content.find((b: any) => b.type === "text")?.text;
  if (!text) die("Réponse du modèle vide.");
  return JSON.parse(text) as MixPlan;
}

/** Résout un morceau proposé contre le catalogue. Renvoie null si introuvable. */
async function resolveMixTrack(t: MixTrack): Promise<{ track: MixTrack; song: CatalogSong | null; exact: boolean }> {
  const results = await catalogSearch(`${t.title} ${t.artist}`, 5);
  if (results.length === 0) return { track: t, song: null, exact: false };
  const wanted = norm(t.artist);
  const match = results.find((r) => {
    const got = norm(r.attributes.artistName);
    return got.includes(wanted) || wanted.includes(got);
  });
  return { track: t, song: match ?? results[0], exact: !!match };
}

async function createCloudPlaylist(name: string, description: string, songIds: string[]): Promise<string | null> {
  const res = await api("/v1/me/library/playlists", {
    method: "POST",
    userToken: true,
    body: {
      attributes: { name, description },
      relationships: { tracks: { data: songIds.map((id) => ({ id, type: "songs" })) } },
    },
  });
  return res?.data?.[0]?.id ?? null;
}

function printCatalog(songs: CatalogSong[]) {
  if (songs.length === 0) { console.log(dim("(aucun résultat)")); return; }
  const w = Math.min(50, Math.max(...songs.map((s) => s.attributes.name.length)));
  for (const s of songs) {
    const a = s.attributes;
    console.log(
      `  ${bold(a.name.slice(0, 50).padEnd(w))}  ${a.artistName.slice(0, 30).padEnd(30)} ${dim(a.albumName.slice(0, 30).padEnd(30))} ${dim(fmtDur(a.durationInMillis / 1000))} ${dim(`#${s.id}`)}`
    );
  }
}

// ---------- helpers ----------

// whose({name}) est cassé pour les noms contenant des emoji, et les getters bulk
// (tracks.persistentID(), etc.) lèvent -1728 sur une playlist vide — d'où ces helpers.
const PLAYLIST_HELPERS = `
  const playlistByName = (name) => {
    const i = Music.playlists.name().indexOf(name);
    if (i === -1) throw "Playlist introuvable : " + name;
    return Music.playlists[i];
  };
  const safeTracks = (pl) => { try { return pl.tracks(); } catch { return []; } };
`;

const TRACK_PROPS = `
  const trackInfo = (t) => ({
    name: t.name(),
    artist: t.artist(),
    album: t.album(),
    duration: t.duration(),
    loved: (() => { try { return t.favorited(); } catch { try { return t.loved(); } catch { return false; } } })(),
    rating: t.rating(),
    playedCount: t.playedCount(),
    id: t.persistentID(),
  });
`;

interface Track {
  name: string;
  artist: string;
  album: string;
  duration: number;
  loved: boolean;
  rating: number;
  playedCount: number;
  id: string;
}

const fmtDur = (s: number) => {
  const m = Math.floor(s / 60);
  return `${m}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
};

const bold = (s: string) => `\x1b[1m${s}\x1b[0m`;
const dim = (s: string) => `\x1b[2m${s}\x1b[0m`;
const green = (s: string) => `\x1b[32m${s}\x1b[0m`;
const red = (s: string) => `\x1b[31m${s}\x1b[0m`;
const heart = (t: Track) => (t.loved ? red(" ♥") : "");

function printTracks(tracks: Track[]) {
  if (tracks.length === 0) {
    console.log(dim("(aucun morceau)"));
    return;
  }
  const w = Math.min(50, Math.max(...tracks.map((t) => t.name.length)));
  for (const t of tracks) {
    console.log(
      `  ${bold(t.name.slice(0, 50).padEnd(w))}  ${t.artist.slice(0, 30).padEnd(30)} ${dim(t.album.slice(0, 30).padEnd(30))} ${dim(fmtDur(t.duration))}${heart(t)}`
    );
  }
}

// ---------- commands ----------

const commands: Record<string, { desc: string; usage?: string; run: (args: string[]) => void | Promise<void> }> = {
  now: {
    desc: "Morceau en cours de lecture",
    run: () => {
      const info = jxa<{ state: string; track: Track | null; position: number } | null>(`
        ${TRACK_PROPS}
        if (!Music.running()) return null;
        const state = Music.playerState();
        let track = null;
        try { track = trackInfo(Music.currentTrack()); } catch {}
        return { state, track, position: track ? Music.playerPosition() : 0 };
      `);
      if (!info || !info.track) {
        console.log(dim("Rien en lecture."));
        return;
      }
      const icon = info.state === "playing" ? green("▶") : "⏸";
      const t = info.track;
      console.log(`${icon} ${bold(t.name)}${heart(t)}`);
      console.log(`  ${t.artist} — ${dim(t.album)}`);
      console.log(`  ${dim(`${fmtDur(info.position)} / ${fmtDur(t.duration)}`)}`);
    },
  },

  play: { desc: "Lancer la lecture", run: () => { jxa(`Music.play()`); console.log(green("▶ lecture")); } },
  pause: { desc: "Mettre en pause", run: () => { jxa(`Music.pause()`); console.log("⏸ pause"); } },
  toggle: { desc: "Play/pause", run: () => { jxa(`Music.playpause()`); commands.now.run([]); } },
  next: { desc: "Morceau suivant", run: () => { jxa(`Music.nextTrack()`); commands.now.run([]); } },
  prev: { desc: "Morceau précédent", run: () => { jxa(`Music.previousTrack()`); commands.now.run([]); } },

  search: {
    desc: "Chercher dans la bibliothèque",
    usage: "am search <termes> [--limit N]",
    run: (args) => {
      const { query, limit } = parseQuery(args);
      if (!query) die("Usage : am search <termes>");
      const tracks = jxa<Track[]>(`
        ${TRACK_PROPS}
        const lib = Music.libraryPlaylists[0];
        const results = Music.search(lib, { for: arg.query });
        return results.slice(0, arg.limit).map(trackInfo);
      `, { query, limit });
      printTracks(tracks);
    },
  },

  playlists: {
    desc: "Lister les playlists",
    run: () => {
      const lists = jxa<{ name: string; count: number; special: string }[]>(`
        return Music.playlists().map(p => ({
          name: p.name(),
          count: p.tracks.length,
          special: (() => { try { return p.specialKind(); } catch { return "none"; } })(),
        })).filter(p => !["Library", "Music"].includes(p.name));
      `);
      const user = lists.filter((l) => l.special === "none");
      const smart = lists.filter((l) => l.special !== "none");
      for (const l of user) console.log(`  ${bold(l.name)} ${dim(`(${l.count})`)}`);
      if (smart.length) {
        console.log(dim("  — système —"));
        for (const l of smart) console.log(`  ${dim(l.name)} ${dim(`(${l.count})`)}`);
      }
    },
  },

  playlist: {
    desc: "Afficher les morceaux d'une playlist",
    usage: "am playlist <nom>",
    run: (args) => {
      const name = args.join(" ");
      if (!name) die("Usage : am playlist <nom>");
      const tracks = jxa<Track[]>(`
        ${TRACK_PROPS}${PLAYLIST_HELPERS}
        return safeTracks(playlistByName(arg)).map(trackInfo);
      `, name);
      printTracks(tracks);
    },
  },

  add: {
    desc: "Ajouter un morceau de la bibliothèque à une playlist",
    usage: "am add <termes> --to <playlist>",
    run: (args) => {
      const toIdx = args.indexOf("--to");
      if (toIdx === -1 || toIdx === args.length - 1) die("Usage : am add <termes> --to <playlist>");
